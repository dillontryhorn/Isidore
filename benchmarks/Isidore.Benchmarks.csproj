<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="System.Buffers" Version="4.6.1" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="System.Drawing" />
    <Reference Include="Isidore.Maths">
      <HintPath>..\Isidore.Maths\bin\Release\Isidore.Maths.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Isidore.ImgProcess">
      <HintPath>..\Isidore.ImgProcess\bin\Release\Isidore.ImgProcess.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Isidore.Load">
      <HintPath>..\Isidore.Load\bin\Release\Isidore.Load.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
